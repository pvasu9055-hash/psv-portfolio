{
  "version": 2,
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vasutech.online" }],
      "destination": "https://www.vasutech.online/:path*",
      "permanent": true
    }
  ]
}
